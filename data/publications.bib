  DATE = {2012-06},
  DOI = {10.1016/j.cagd.2011.04.002},
  ISSN = {0167-8396},
  JOURNALTITLE = {Comput. Aided Geom. Des.},
  KEYWORDS = {Voronoi cell,Spiral curve,Point-projection,Nearest point,Minimum distance,Line/plane clipping,Evolute,Circle/sphere clipping,Bisector curve},
  NUMBER = {5},
  PAGES = {242--254},
  TITLE = {Efficient point-projection to freeform curves and surfaces},
  VOLUME = {29},
}

@ARTICLE{10.1145/2070781.2024203,
  ABSTRACT = {We present a compact representation for the bounding volume hierarchy (BVH) of freeform NURBS surfaces using Coons patches. Following the Coons construction, each subpatch can be bounded very efficiently using the bilinear surface determined by the four corners. The BVH of freeform surfaces is represented as a hierarchy of Coons patch approximation until the difference is reduced to within a given error bound. Each leaf node contains a single Coons patch, where a detailed BVH for the patch can be represented very compactly using two lists (containing curve approximation errors) of length proportional only to the height of the BVH. We demonstrate the effectiveness of our compact BVH representation using several experimental results from real-time applications in collision detection and minimum distance computation for freeform models.},
  AUTHOR = {Kim, Yong-Joon and Oh, Young-Taek and Yoon, Seung-Hyun and Kim, Myung-Soo and Elber, Gershon},
  LOCATION = {New York, NY, USA},
  PUBLISHER = {Association for Computing Machinery},
  URL = {https://doi.org/10.1145/2070781.2024203},
  DATE = {2011-12},
  DOI = {10.1145/2070781.2024203},
  ISSN = {0730-0301},
  JOURNALTITLE = {ACM Trans. Graph.},
  KEYWORDS = {Coons patch,NURBS,bilinear surface,bounding volume hierarchy (BVH),collision detection,freeform surface,minimum distance computation,offset,tetrahedron},
  NUMBER = {6},
  PAGES = {1--8},
  TITLE = {Coons {BVH} for freeform geometric models},
  VOLUME = {30},
}

@ARTICLE{10.1007/s00371-010-0477-3,
  ABSTRACT = {We present a real-time algorithm for computing the precise Hausdorff Distance (HD) between two planar freeform curves. The algorithm is based on an effective technique that approximates each curve with a sequence of G 1 biarcs within an arbitrary error bound. The distance map for the union of arcs is then given as the lower envelope of trimmed truncated circular cones, which can be rendered efficiently to the graphics hardware depth buffer. By sampling the distance map along the other curve, we can estimate a lower bound for the HD and eliminate many redundant curve segments using the lower bound. For the remaining curve segments, we read the distance map and detect the pixel(s) with the maximum distance. Checking a small neighborhood of the maximum-distance pixel, we can reduce the computation to considerably smaller subproblems, where we employ a multivariate equation solver for an accurate solution to the original problem. We demonstrate the effectiveness of the proposed approach using several experimental results.},
  AUTHOR = {Kim, Yong-Joon and Oh, Young-Taek and Yoon, Seung-Hyun and Kim, Myung-Soo and Elber, Gershon},
  LOCATION = {Berlin, Heidelberg},
  PUBLISHER = {Springer-Verlag},
  URL = {https://doi.org/10.1007/s00371-010-0477-3},
  DATE = {2010-06},
  DOI = {10.1007/s00371-010-0477-3},
  ISSN = {0178-2789},
  JOURNALTITLE = {Vis. Comput.},
  KEYWORDS = {Trimming,Lower bound,Distance map,Depth buffer,Biarc approximation},
  NUMBER = {6–8},
  PAGES = {1007--1016},
  TITLE = {Precise {Hausdorff} distance computation for planar freeform curves using biarcs and depth buffer},
  VOLUME = {26},
}

